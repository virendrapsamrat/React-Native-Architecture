EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_ENV=development

# White-label / branding configuration
# Select a brand key such as "default", "brandA", "brandB".
EXPO_PUBLIC_BRAND=default

# Optional overrides (defaults are defined in app.config.ts)
EXPO_PUBLIC_APP_NAME=RN Architecture App
EXPO_PUBLIC_APP_SLUG=rn-architecture-app
EXPO_PUBLIC_APP_ICON=./assets/icon.png
EXPO_PUBLIC_SPLASH_IMAGE=./assets/splash-icon.png
EXPO_PUBLIC_IOS_BUNDLE_IDENTIFIER=com.rnarchitecture.app
EXPO_PUBLIC_ANDROID_PACKAGE=com.rnarchitecture.app
EXPO_PUBLIC_APP_SCHEME=rnarchitectureapp
